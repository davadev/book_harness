{
  "name": "book-harness",
  "version": "0.1.0",
  "description": "Obsidian plugin to write, understand, translate and publish books with optional local AI.",
  "main": "main.js",
  "license": "MIT",
  "author": "davadev",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check-release": "node scripts/check-release.mjs",
    "sync": "node scripts/sync-main.mjs",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "lint:css": "stylelint styles.css",
    "lint:deps": "eslint -c eslint.deps.config.mjs package.json --max-warnings=0",
    "lint:cloud-parity": "node scripts/lint-cloud-parity.mjs",
    "check:dead-code": "knip --production && knip --no-config-hints --include dependencies,unlisted,binaries,unresolved",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^24",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-depend": "1.5.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "21.0.4",
    "jsonc-eslint-parser": "3.3.0",
    "knip": "^6.38.0",
    "obsidian": "1.13.0",
    "stylelint": "17.16.0",
    "stylelint-no-unsupported-browser-features": "8.1.2",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "fflate": "0.8.2",
    "yaml": "2.9.1"
  }
}
